# API keys for data ingest. Copy to .env in the repo root and fill in:  cp .env.example .env
# .env is gitignored. Never commit real keys (AGENTS.md rule 0).
# Environment variables of the same name take precedence over .env.
# The starter package's build_dataset.py reads the same names: --env-file ../../.env

# Fingrid Open Data, https://data.fingrid.fi (register for a free key). Used by tools/ingest/fingrid.py.
FINGRID_API_KEY=

# ENTSO-E Transparency Platform security token. NOT NEEDED IN OUR SETUP: the organiser provided the
# ENTSO-E series ready-made in the starter package data. Only needed if we fetch new ENTSO-E series
# ourselves or rerun build_dataset.py; then register at https://transparency.entsoe.eu and email
# transparency@entsoe.eu (access takes several working days). Leave empty otherwise.
ENTSOE_API_TOKEN=

# No key needed:
# - Open-Meteo Single Runs API (tools/ingest/openmeteo.py), free non-commercial tier
# - FMI open data
# - OpenStreetMap Overpass API (tools/ingest/windsites.py)
